{
    "renderAspect": "16/9",
    "noCloud": true,
    "backend": "dosbox",
    "renderBackend": "webgl",
    "backendLocked": false,
    "mouseCapture": false,
    "noCursor": false,
    "softKeyboardLayout": [
        [
            [
                " w ",
                "a s d"
            ],
            [
                "{esc}",
                "{up} {enter} {down}"
            ],
            [
                "{f2} {f3}",
                "1 2 3 4 5 6 7"
            ],
            [
                "e {space} {shift}",
                "{left} {right}"
            ]
        ]
    ],
    "softKeyboardSymbols": [
        {
            "w": "↑",
            "s": "↓",
            "a": "←",
            "d": "→",
            "{up}": "↑",
            "{down}": "↓",
            "{left}": "Aim left",
            "{right}": "Aim right",
            "{enter}": "Ok",
            "e": "Use",
            "{space}": "Shoot",
            "{shift}": "Run",
            "{esc}": "Main menu",
            "{f2}": "Quick save",
            "{f3}": "Quick load"
        }
    ]
} 